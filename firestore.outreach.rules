// Prospect OS — outreach collections security rules
// PASTE THESE MATCH BLOCKS INSIDE your existing
//   service cloud.firestore { match /databases/{database}/documents { ... } }
// block, alongside your current Prospect OS rules. Do not replace your file —
// deploying rules replaces the whole ruleset, so merge, then deploy.

    function outreachOwner() {
      return request.auth != null
        && request.auth.uid ==
           get(/databases/$(database)/documents/outreach_settings/config).data.ownerUid;
    }

    // Credentials and engine state: NO client access, ever.
    // Cloud Functions use the Admin SDK, which bypasses rules by design.
    match /outreach_private/{doc} {
      allow read, write: if false;
    }

    // Bootstrap: config may be created once by any signed-in user (the seed
    // call sets ownerUid); after that, owner-only.
    match /outreach_settings/{doc} {
      allow read, update, delete: if outreachOwner();
      allow create: if request.auth != null;
    }

    match /outreach_contacts/{doc}    { allow read, write: if outreachOwner(); }
    match /outreach_suppression/{doc} { allow read, write: if outreachOwner(); }
    match /outreach_enrollments/{doc} { allow read, write: if outreachOwner(); }
    match /outreach_sends/{doc}       { allow read, write: if outreachOwner(); }
    match /outreach_replies/{doc}     { allow read, write: if outreachOwner(); }
    match /outreach_meetings/{doc}    { allow read, write: if outreachOwner(); }
    match /outreach_sequences/{doc}   { allow read, write: if outreachOwner(); }
    match /outreach_counters/{doc}    { allow read: if outreachOwner(); }
    match /outreach_log/{doc}         { allow read: if outreachOwner(); }
